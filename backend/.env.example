PANGRAM_DATA_DIR=.data
PANGRAM_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PANGRAM_WORKER_ENABLED=true
PANGRAM_ALLOW_LOCAL_MODEL_ENDPOINTS=false
# Leave unset until Hugging Face has approved access to both repositories.
# HF_TOKEN=
# Optional explicit compute device: cpu, mps, cuda
PANGRAM_MODEL_DEVICE=auto

# Optional parent directory for the downloaded Qwen checkpoint:
# PANGRAM_MODEL_DIR=/absolute/path/to/models

# Lossless findings objects: local for development; s3 for R2/AWS/compatible storage.
PANGRAM_RESULT_STORAGE=local
# PANGRAM_RESULT_STORAGE=s3
# PANGRAM_RESULT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# PANGRAM_RESULT_S3_BUCKET=pangram-findings
# PANGRAM_RESULT_S3_REGION=auto
# Set credentials in the deployment secret manager, never in frontend variables.
# PANGRAM_RESULT_S3_ACCESS_KEY=
# PANGRAM_RESULT_S3_SECRET_KEY=
PANGRAM_RESULT_S3_PREFIX=findings/v1
PANGRAM_RESULT_CACHE_BYTES=33554432
